# Use only a dedicated IPPAN Neon database.
IPPAN_DATABASE_URL=postgresql://USER:PASSWORD@YOUR-IPPAN-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Set to 0 when using Neon. Never enable local mode in production.
IPPAN_LOCAL_DEMO=0
# A separate strong password to seed evaluation accounts on the first launch.
IPPAN_DEMO_PASSWORD=
# Set the canonical HTTPS origin when deploying, e.g. https://ippan-demo.example.com
IPPAN_SITE_URL=
